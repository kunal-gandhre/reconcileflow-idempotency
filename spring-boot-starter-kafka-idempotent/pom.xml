<!-- Starter module: adds Kafka integration and conditional Spring Boot bean registration. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <!-- Inherit dependency versions and build defaults instead of choosing them per module. -->
  <parent><groupId>com.reconcileflow</groupId><artifactId>reconcileflow</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>spring-boot-starter-kafka-idempotent</artifactId>
  <!-- Application dependencies are compiled normally; test helpers use test scope where declared. -->
  <dependencies>
    <dependency><groupId>com.reconcileflow</groupId><artifactId>kafka-idempotent-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
