<!-- Aggregator: build the core first, then the starter, then the runnable integration example. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- Inherit dependency versions and build defaults instead of choosing them per module. -->
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.6</version><relativePath/></parent>
  <groupId>com.reconcileflow</groupId><artifactId>reconcileflow</artifactId><version>0.1.0-SNAPSHOT</version><packaging>pom</packaging>
  <name>ReconcileFlow</name><description>Redis-backed consumer deduplication for Java and Go</description>
  <properties><java.version>21</java.version></properties>
  <!-- Reactor order follows dependencies; no application code is packaged by this POM. -->
  <modules><module>kafka-idempotent-core</module><module>spring-boot-starter-kafka-idempotent</module><module>examples/order-service</module></modules>
</project>
