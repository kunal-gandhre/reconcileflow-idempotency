<!-- Example module: consumes the local starter artifact and packages an executable demo JAR. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <!-- Inherit dependency versions and build defaults instead of choosing them per module. -->
  <parent><groupId>com.reconcileflow</groupId><artifactId>reconcileflow</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>order-service</artifactId>
  <!-- Application dependencies are compiled normally; test helpers use test scope where declared. -->
  <dependencies><dependency><groupId>com.reconcileflow</groupId><artifactId>spring-boot-starter-kafka-idempotent</artifactId><version>${project.version}</version></dependency></dependencies>
  <build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build>
</project>
